* text=auto
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.java text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.rc.in text eol=lf
*.cmake text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.ico binary
*.png binary
# Caption provenance and generated assets have byte-exact build checks.
/.gitattributes text eol=lf
/third_party/wa2_subtitles/*.inc text eol=lf
/third_party/wa2_subtitles/sub.yaml -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/third_party/wa2_subtitles/LICENSE -text
# Preserve the upstream YAML's CRLFs and the font license's final blank line.
/third_party/wa2_subtitles/FONT-NOTICE.txt -text whitespace=blank-at-eol,space-before-tab,-blank-at-eof
# Historical differential archives bind these ABI headers byte for byte.
# Keep their existing bytes instead of silently normalizing cached inputs.
/recompiled/functions.hpp -text
/recompiled/process.hpp -text
/tools/WindowsRecompTool-main/include/winrecomp/process.hpp -text
/tools/WindowsRecompTool-main/include/winrecomp/memory.hpp -text
/tools/WindowsRecompTool-main/include/winrecomp/win32_state.hpp -text
