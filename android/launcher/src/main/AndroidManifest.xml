<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.wa2.launcher" android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <queries>
        <package android:name="org.wa2.port" />
        <intent>
            <action android:name="org.wa2.launcher.action.RUN_MAIN" />
        </intent>
        <intent>
            <action android:name="org.wa2.launcher.action.RUN_SPECIAL_CONTENTS" />
        </intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@drawable/launcher_icon"
        android:allowBackup="false" android:theme="@style/LauncherTheme">
        <activity android:name=".LauncherActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
