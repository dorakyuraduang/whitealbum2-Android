# The Python preparation step is common to every compiler/architecture. Verify
# its cached inputs, recipe and derived bytes before replacing two source paths.
set(WA2_CHROMA_META "${WA2_SHARED_ROOT}/generated/shared-aot/native/provenance.json")
if(NOT EXISTS "${WA2_CHROMA_META}")
    message(FATAL_ERROR "Run python scripts/prepare_shared_chroma.py on the existing cached C++ first")
endif()
file(READ "${WA2_CHROMA_META}" WA2_CHROMA_JSON)
foreach(kind inputs outputs)
    string(JSON count LENGTH "${WA2_CHROMA_JSON}" ${kind})
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
        string(JSON name MEMBER "${WA2_CHROMA_JSON}" ${kind} ${index})
        string(JSON expected GET "${WA2_CHROMA_JSON}" ${kind} "${name}")
        file(SHA256 "${WA2_SHARED_ROOT}/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Stale shared chroma source; rerun preparation: ${name}")
        endif()
    endforeach()
endforeach()
foreach(unit functions_1.cpp functions_2.cpp)
    list(REMOVE_ITEM WA2_SHARED_AOT_SOURCES "${WA2_SHARED_ROOT}/generated/shared-aot/${unit}")
    list(APPEND WA2_SHARED_AOT_SOURCES "${WA2_SHARED_ROOT}/generated/shared-aot/native/${unit}")
endforeach()
