set(WA2_TEXT_FLOW_META "${WA2_SHARED_ROOT}/generated/shared-aot/native-text/provenance.json")
if(NOT EXISTS "${WA2_TEXT_FLOW_META}")
    message(FATAL_ERROR "Run python scripts/prepare_shared_text_flow.py on cached C++ first")
endif()
file(READ "${WA2_TEXT_FLOW_META}" WA2_TEXT_FLOW_JSON)
foreach(kind inputs outputs)
    string(JSON count LENGTH "${WA2_TEXT_FLOW_JSON}" ${kind})
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
        string(JSON name MEMBER "${WA2_TEXT_FLOW_JSON}" ${kind} ${index})
        string(JSON expected GET "${WA2_TEXT_FLOW_JSON}" ${kind} "${name}")
        file(SHA256 "${WA2_SHARED_ROOT}/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Stale shared text flow; rerun preparation: ${name}")
        endif()
    endforeach()
endforeach()
list(REMOVE_ITEM WA2_SHARED_AOT_SOURCES "${WA2_SHARED_ROOT}/generated/shared-aot/native-language/functions_hot.cpp")
list(APPEND WA2_SHARED_AOT_SOURCES "${WA2_SHARED_ROOT}/generated/shared-aot/native-text/functions_hot.cpp")
foreach(unit native/functions_2.cpp functions_3.cpp functions_6.cpp native-progress/functions_7.cpp)
    list(REMOVE_ITEM WA2_SHARED_AOT_SOURCES "${WA2_SHARED_ROOT}/generated/shared-aot/${unit}")
    get_filename_component(name "${unit}" NAME)
    list(APPEND WA2_SHARED_AOT_SOURCES "${WA2_SHARED_ROOT}/generated/shared-aot/native-text/${name}")
endforeach()
list(APPEND WA2_SHARED_AOT_SOURCES "${WA2_SHARED_ROOT}/generated/shared-aot/native-text/text_helpers.cpp")
