set(WA2_LANGUAGE_META "${WA2_SHARED_ROOT}/generated/shared-aot/native-language/provenance.json")
if(NOT EXISTS "${WA2_LANGUAGE_META}")
    message(FATAL_ERROR "Run python scripts/prepare_shared_language.py on cached C++ first")
endif()
file(READ "${WA2_LANGUAGE_META}" WA2_LANGUAGE_JSON)
foreach(kind inputs outputs)
    string(JSON count LENGTH "${WA2_LANGUAGE_JSON}" ${kind})
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
        string(JSON name MEMBER "${WA2_LANGUAGE_JSON}" ${kind} ${index})
        string(JSON expected GET "${WA2_LANGUAGE_JSON}" ${kind} "${name}")
        file(SHA256 "${WA2_SHARED_ROOT}/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Stale shared language source; rerun preparation: ${name}")
        endif()
    endforeach()
endforeach()
foreach(unit functions_4.cpp functions_hot.cpp)
    list(REMOVE_ITEM WA2_SHARED_AOT_SOURCES "${WA2_SHARED_ROOT}/generated/shared-aot/${unit}")
    list(APPEND WA2_SHARED_AOT_SOURCES "${WA2_SHARED_ROOT}/generated/shared-aot/native-language/${unit}")
endforeach()
