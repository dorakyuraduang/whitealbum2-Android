set(WA2_PROGRESS_META "${WA2_SHARED_ROOT}/generated/shared-aot/native-progress/provenance.json")
if(NOT EXISTS "${WA2_PROGRESS_META}")
    message(FATAL_ERROR "Run python scripts/prepare_shared_progress.py on cached C++ first")
endif()
file(READ "${WA2_PROGRESS_META}" WA2_PROGRESS_JSON)
foreach(kind inputs outputs)
    string(JSON count LENGTH "${WA2_PROGRESS_JSON}" ${kind})
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
        string(JSON name MEMBER "${WA2_PROGRESS_JSON}" ${kind} ${index})
        string(JSON expected GET "${WA2_PROGRESS_JSON}" ${kind} "${name}")
        file(SHA256 "${WA2_SHARED_ROOT}/${name}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Stale shared progress source; rerun preparation: ${name}")
        endif()
    endforeach()
endforeach()
foreach(unit functions_0.cpp functions_7.cpp)
    list(REMOVE_ITEM WA2_SHARED_AOT_SOURCES "${WA2_SHARED_ROOT}/generated/shared-aot/${unit}")
    list(APPEND WA2_SHARED_AOT_SOURCES "${WA2_SHARED_ROOT}/generated/shared-aot/native-progress/${unit}")
endforeach()
