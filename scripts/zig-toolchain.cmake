set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
get_filename_component(WA2_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(WA2_ZIG "${WA2_ROOT}/tools/python/ziglang/zig.exe")
set(CMAKE_C_COMPILER "${WA2_ZIG}")
set(CMAKE_C_COMPILER_ARG1 cc)
set(CMAKE_CXX_COMPILER "${WA2_ZIG}")
set(CMAKE_CXX_COMPILER_ARG1 c++)
set(CMAKE_ASM_COMPILER "${WA2_ZIG}")
set(CMAKE_ASM_COMPILER_ARG1 cc)
set(CMAKE_C_FLAGS_INIT "-target x86_64-windows-gnu")
set(CMAKE_CXX_FLAGS_INIT "-target x86_64-windows-gnu")
set(CMAKE_ASM_FLAGS_INIT "-target x86_64-windows-gnu")
set(CMAKE_AR "${WA2_ROOT}/scripts/zig-ar.cmd")
set(CMAKE_RANLIB "${WA2_ROOT}/scripts/zig-ranlib.cmd")
set(CMAKE_MAKE_PROGRAM "${WA2_ROOT}/tools/python/bin/ninja.exe" CACHE FILEPATH "")
set(ZYAN_ZYCORE_PATH "${WA2_ROOT}/tools/WindowsRecompTool-main/third_party/zydis/dependencies/zycore" CACHE PATH "")
