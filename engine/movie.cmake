get_filename_component(WA2_MEDIA_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(ANDROID)
    set(WA2_CODEC_PLATFORM arm64)
else()
    set(WA2_CODEC_PLATFORM windows)
endif()
set(WA2_CODEC_PREFIX "${WA2_MEDIA_ROOT}/tools/media-codec/${WA2_CODEC_PLATFORM}")
foreach(component avformat avcodec avutil)
    if(NOT EXISTS "${WA2_CODEC_PREFIX}/lib/lib${component}.a")
        message(FATAL_ERROR "Build the minimal codec first: scripts/build_media_codec.py --target ${WA2_CODEC_PLATFORM}")
    endif()
    add_library(wa2_ff_${component} STATIC IMPORTED)
    set_target_properties(wa2_ff_${component} PROPERTIES IMPORTED_LOCATION "${WA2_CODEC_PREFIX}/lib/lib${component}.a")
endforeach()
add_library(wa2_movie STATIC "${WA2_MEDIA_ROOT}/engine/movie_reader.cpp" "${WA2_MEDIA_ROOT}/engine/movie_player.cpp")
add_library(wa2_wave_codec STATIC "${WA2_MEDIA_ROOT}/engine/wave_codec.cpp")
target_compile_features(wa2_wave_codec PUBLIC cxx_std_20)
target_include_directories(wa2_wave_codec PUBLIC "${WA2_MEDIA_ROOT}/engine" PRIVATE "${WA2_CODEC_PREFIX}/include")
target_link_libraries(wa2_wave_codec PUBLIC wa2_ff_avcodec wa2_ff_avutil)
set_target_properties(wa2_wave_codec PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_include_directories(wa2_movie PUBLIC "${WA2_MEDIA_ROOT}/engine" PRIVATE "${WA2_CODEC_PREFIX}/include")
target_compile_features(wa2_movie PUBLIC cxx_std_20)
set_target_properties(wa2_movie PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_link_libraries(wa2_movie PUBLIC wa2_engine PRIVATE wa2_ff_avformat wa2_ff_avcodec wa2_ff_avutil)
if(ANDROID)
    target_link_libraries(wa2_movie PRIVATE m)
elseif(WIN32)
    target_link_libraries(wa2_movie PRIVATE bcrypt)
endif()
