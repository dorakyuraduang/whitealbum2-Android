include_guard(GLOBAL)
get_filename_component(WA2_NATIVE_DESKTOP_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
function(wa2_add_native_desktop_entry target)
    if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT TARGET wa2_native_application)
        message(FATAL_ERROR "The native desktop entry currently requires Windows x64 and the shared native application")
    endif()
    include("${WA2_NATIVE_DESKTOP_ROOT}/platform/native_host.cmake")
    add_executable(${target} WIN32 "${WA2_NATIVE_DESKTOP_ROOT}/hosts/native/windows_main.cpp")
    set(WA2_ROOT "${WA2_NATIVE_DESKTOP_ROOT}")
    configure_file("${WA2_ROOT}/hosts/app.rc.in" "${CMAKE_CURRENT_BINARY_DIR}/${target}.rc" @ONLY)
    set(icon_resource "${CMAKE_CURRENT_BINARY_DIR}/${target}.res")
    add_custom_command(OUTPUT "${icon_resource}"
        COMMAND "${WA2_ROOT}/tools/python/ziglang/zig.exe" rc /fo "${icon_resource}" "${CMAKE_CURRENT_BINARY_DIR}/${target}.rc"
        DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/${target}.rc" "${WA2_ROOT}/icon.ico" VERBATIM)
    set_source_files_properties("${icon_resource}" PROPERTIES GENERATED TRUE EXTERNAL_OBJECT TRUE)
    target_sources(${target} PRIVATE "${icon_resource}")
    if(TARGET SDL2main)
        target_link_libraries(${target} PRIVATE SDL2main)
    else()
        target_sources(${target} PRIVATE "${WA2_NATIVE_DESKTOP_ROOT}/tools/SDL-release-2.32.10/src/main/windows/SDL_windows_main.c")
        target_link_libraries(${target} PRIVATE shell32)
    endif()
    target_compile_features(${target} PRIVATE cxx_std_20)
    if(NOT MSVC)
        target_link_options(${target} PRIVATE "-Wl,--subsystem,windows")
    endif()
    target_link_libraries(${target} PRIVATE wa2_native_host wa2_native_desktop_resources)
endfunction()
