option(WA2_COMPACT_FALLBACK "Share identical C++ fallback function bodies" ON)
if(WA2_COMPACT_FALLBACK)
    set(WA2_COMPACT_DIR "${CMAKE_BINARY_DIR}/compact-fallback")
    set(WA2_COMPACT_OUTPUTS "${WA2_COMPACT_DIR}/compact_ops.cpp" "${WA2_COMPACT_DIR}/compact_ops.hpp"
        "${WA2_COMPACT_DIR}/original_code.S" "${WA2_COMPACT_DIR}/original_code.bin" "${WA2_COMPACT_DIR}/manifest.json")
    set(WA2_COMPACT_PAGES)
    foreach(source IN LISTS WA2_NATIVE_ORACLES)
        get_filename_component(name "${source}" NAME)
        list(APPEND WA2_COMPACT_OUTPUTS "${WA2_COMPACT_DIR}/${name}")
        list(APPEND WA2_COMPACT_OUTPUTS "${WA2_COMPACT_DIR}/release/${name}")
        list(APPEND WA2_COMPACT_PAGES "${WA2_COMPACT_DIR}/${name}")
    endforeach()
    add_custom_command(OUTPUT ${WA2_COMPACT_OUTPUTS}
        COMMAND "${Python3_EXECUTABLE}" "${WA2_PROJECT_ROOT}/scripts/compact_fallback.py" --out "${WA2_COMPACT_DIR}"
        DEPENDS "${WA2_PROJECT_ROOT}/scripts/compact_fallback.py" "${WA2_PROJECT_ROOT}/scripts/retired_modules.py"
            "${CMAKE_CURRENT_SOURCE_DIR}/retired_modules.json" "${CMAKE_CURRENT_SOURCE_DIR}/native_functions.json" "${WA2_IMAGE_PATH}" ${WA2_NATIVE_ORACLES}
        WORKING_DIRECTORY "${WA2_PROJECT_ROOT}" VERBATIM)
    add_custom_target(wa2_compact_generated DEPENDS ${WA2_COMPACT_OUTPUTS})
    add_library(wa2_compact_ops STATIC "${WA2_COMPACT_DIR}/compact_ops.cpp" "${WA2_COMPACT_DIR}/original_code.S")
    add_dependencies(wa2_compact_ops wa2_compact_generated)
    target_include_directories(wa2_compact_ops PUBLIC "${WA2_COMPACT_DIR}")
    target_link_libraries(wa2_compact_ops PUBLIC winrecomp_guest)
    target_link_libraries(wa2_port PUBLIC wa2_compact_ops)
    target_compile_definitions(wa2_port PRIVATE WA2_COMPACT_FALLBACK=1)
    target_compile_options(wa2_compact_ops PRIVATE $<$<COMPILE_LANGUAGE:CXX>:-Oz;-ffunction-sections;-fdata-sections>)
    set_source_files_properties(${WA2_COMPACT_PAGES} DIRECTORY "${WA2_PROJECT_ROOT}/generated/wa2-win64" "${CMAKE_CURRENT_SOURCE_DIR}"
        PROPERTIES COMPILE_OPTIONS "-Oz")
    get_property(main_targets DIRECTORY "${WA2_PROJECT_ROOT}/generated/wa2-win64" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(port_targets DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS main_targets port_targets)
        get_target_property(sources ${target} SOURCES)
        if(NOT sources)
            continue()
        endif()
        set(compact_sources)
        set(replaced FALSE)
        get_target_property(source_dir ${target} SOURCE_DIR)
        foreach(source IN LISTS sources)
            if(target STREQUAL "recompiled_program" AND source MATCHES "(^|/)embedded_image[.]S$")
                set(replaced TRUE)
            elseif(source MATCHES "(^|/)code_page_[0-9]+[.]cpp$")
                get_filename_component(name "${source}" NAME)
                if(target STREQUAL "recompiled_program")
                    list(APPEND compact_sources "${WA2_COMPACT_DIR}/release/${name}")
                else()
                    list(APPEND compact_sources "${WA2_COMPACT_DIR}/${name}")
                endif()
                set(replaced TRUE)
            elseif(IS_ABSOLUTE "${source}" OR source MATCHES "^\\$<")
                list(APPEND compact_sources "${source}")
            else()
                list(APPEND compact_sources "${source_dir}/${source}")
            endif()
        endforeach()
        if(replaced)
            set_property(TARGET ${target} PROPERTY SOURCES "${compact_sources}")
            target_include_directories(${target} PRIVATE "${WA2_COMPACT_DIR}")
            target_link_libraries(${target} PRIVATE wa2_compact_ops)
            add_dependencies(${target} wa2_compact_generated)
        endif()
    endforeach()
endif()
